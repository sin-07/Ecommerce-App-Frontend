{
  "expo": {
    "name": "AP Enterprises",
    "slug": "ap-enterprises",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Ap-Enterprises.jpeg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/Ap-Enterprises.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#fffdeb"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Ap-Enterprises.jpeg",
        "backgroundColor": "#fffdeb"
      },
      "package": "com.apenterprises.b2b",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/Ap-Enterprises.jpeg"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-notifications",
      "expo-dev-client"
    ],
    "extra": {
      "eas": {
        "projectId": "dc96537a-5ea1-4e75-8dc8-8247a0a103a2"
      }
    }
  }
}
